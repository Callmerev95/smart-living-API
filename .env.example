# =========================================
# Smart Living API — contoh environment
# Copy ke .env lalu sesuaikan. JANGAN commit .env.
# =========================================

# --- API ---
API_PORT=8000
# Daftar origin yang diizinkan. Boleh comma-separated atau JSON array.
# JANGAN gunakan "*" — CORS harus dibatasi ke domain yang dibutuhkan.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Recommendation engine (lihat docs/content-schema.md §A.7) ---
DEFAULT_LIMIT=5
MAX_LIMIT=10
MIN_MATCH_THRESHOLD=30
MAX_INGREDIENTS_PER_REQUEST=30
MAX_INGREDIENT_NAME_LENGTH=60

# --- Dataset (relatif ke root repo bila bukan absolute path) ---
RECIPES_PATH=data/recipes/recipes.json
INGREDIENTS_PATH=data/recipes/ingredients.json

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- AI (future phase — TIDAK dipakai di MVP) ---
# Simpan hanya di sisi server. Jangan pernah expose ke frontend.
OPENAI_API_KEY=
OPENAI_MODEL=
